<?php

/**
 * @file
 * Functions to support theming in the arcana theme.
 */

/**
 * Implements hook_preprocess_block().
 */
function arcana_preprocess_block(&$variables) {

  // Sets a frontpage variable for themeing.
  if ($variables['plugin_id'] === 'system_branding_block') {
    if (\Drupal::service('path.matcher')->isFrontPage()) {
      $variables['is_front'] = TRUE;
    }
  }

  // Removes the title from the homepage.
  if ($variables['plugin_id'] === 'page_title_block') {
    if (\Drupal::service('path.matcher')->isFrontPage()) {
      $variables['content'] = NULL;
    }
  }
}

/**
 * Implements hook_preprocess_page_title().
 */
function arcana_preprocess_page_title(&$variables) {
  $node = \Drupal::request()->attributes->get('node');
  if ($node) {
    if ($node->getType() === 'book') {
      $sub_title = $node->get('field_subtitle')->value;
      if ($sub_title) {
        $variables['sub_title']['#markup'] = $sub_title;
      }
    }
  }
}

/**
 *
 */
function arcana_preprocess_node(&$variables) {

  if (\Drupal::service('path.matcher')->isFrontPage()) {
    $variables['is_front'] = TRUE;
    unset($variables['content']['book_navigation']);
    unset($variables['content']['links']);

  }

}

/**
 * Implements template_preprocess_book_all_books_block().
 */
function arcana_preprocess_book_all_books_block(&$variables) {
  $book_manager = \Drupal::service('book.manager');

  // Determine the current book context.
  $current_bid = 0;
  $node = \Drupal::routeMatch()->getParameter('node');
  if ($node instanceof \Drupal\book\BookInterface) {
    $book = $node->getBook();
    if (!empty($book['bid'])) {
      $current_bid = $book['bid'];
    }
  }

  // On non-book pages, the contrib block only renders a top-level link per
  // book. Rebuild the full tree so the sidebar shows the complete outline
  // everywhere.
  $books = $book_manager->getAllBooks();
  foreach ($variables['book_menus'] as $index => &$menu_data) {
    $book_id = $menu_data['id'];
    if ($book_id != $current_bid && isset($books[$book_id])) {
      $data = $book_manager->bookTreeAllData($book_id, $books[$book_id]);
      $menu_data['menu'] = $book_manager->bookTreeOutput($data);
      $menu_data['menu']['#book_title'] = $books[$book_id]['title'];
    }
  }
  unset($menu_data);

  // Mark the front-page item so book-tree.html.twig can skip the link on the
  // top-level entry that points at the site front page.
  $front = \Drupal::config('system.site')->get('page.front');
  $front_nid = substr($front, 6);
  foreach ($variables['book_menus'] as $index => &$menu_data) {
    if (!empty($menu_data['menu']['#items'][$front_nid])) {
      $menu_data['menu']['#items'][$front_nid]['is_front'] = TRUE;
    }
  }
  unset($menu_data);
}
